# Optional: Moonfold Connect source builds
# `cp .env.example .env` enables Moonfold Connect against the production deployment.
# These are the same public identifiers baked into official release builds, not
# secrets. Remove or comment them out to build with cloud features disabled.
# Do not add server-side secrets to this file.

# Production Clerk instance. To use your own, get these from the Clerk Dashboard
# under API keys, JWT templates, and OAuth applications.
MOONFOLD_CLERK_PUBLISHABLE_KEY=pk_live_Y2xlcmsudDMuY29kZXMk
MOONFOLD_CLERK_JWT_TEMPLATE=moonfold-relay
MOONFOLD_CLERK_CLI_OAUTH_CLIENT_ID=hzxSgY2cH10sDU2r

# Optional: signed macOS passkey builds. The RP domain defaults to the Frontend API
# hostname encoded in MOONFOLD_CLERK_PUBLISHABLE_KEY. Set the override only when Clerk
# returns a different RP ID or when multiple domains must be entitled.
# MOONFOLD_APPLE_TEAM_ID=ABC1234567
# MOONFOLD_MACOS_PROVISIONING_PROFILE=/absolute/path/to/moonfold.provisionprofile
# MOONFOLD_CLERK_PASSKEY_RP_DOMAINS=example.clerk.accounts.dev,clerk.example.com

# Optional relay for Moonfold Connect. Moonfold builds ship without one; set this only when
# you deploy your own relay from `infra/relay`.
# MOONFOLD_RELAY_URL=https://relay.example.com

# Optional: hosted web app origin used by the CLI's out-of-band OAuth flow.
# Moonfold has no default hosted app.
# MOONFOLD_HOSTED_APP_URL=https://app.example.com

# Public, ingest-only mobile OpenTelemetry configuration.
# MOONFOLD_MOBILE_OTLP_TRACES_URL=https://api.axiom.co/v1/traces
# MOONFOLD_MOBILE_OTLP_TRACES_DATASET=moonfold-mobile-traces-dev
# MOONFOLD_MOBILE_OTLP_TRACES_TOKEN=xaat-...
