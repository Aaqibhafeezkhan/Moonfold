<?xml version="1.0" encoding="UTF-8"?>
<component type="desktop-application">
  <id>dev.moonfold.app</id>
  <metadata_license>CC0-1.0</metadata_license>
  <project_license>MIT</project_license>
  <name>Moonfold</name>
  <summary>Desktop GUI for coding agents</summary>
  <developer id="dev.moonfold">
    <name>Moonfold contributors</name>
  </developer>
  <description>
    <p>
      Moonfold is an open-source desktop app for coding agents. Work with your
      existing agent subscriptions, review code changes, and run commands in
      your projects.
    </p>
    <p>
      Connect from a browser on another device to continue working remotely.
    </p>
  </description>
  <launchable type="desktop-id">moonfold.desktop</launchable>
  <icon type="stock">moonfold</icon>
  <provides>
    <binary>moonfold</binary>
  </provides>
  <categories>
    <category>Development</category>
  </categories>
  <url type="homepage">https://github.com/Mr-Dark-debug/Moonfold</url>
  <url type="bugtracker">https://github.com/Mr-Dark-debug/Moonfold/issues</url>
  <url type="vcs-browser">https://github.com/Mr-Dark-debug/Moonfold</url>
</component>
